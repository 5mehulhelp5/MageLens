#!/usr/bin/env bash
source "$(dirname "$0")/common"
preflight
command -v git >/dev/null || fail 'Install Git, then rerun ./install.sh.'
container_only=0
requested_domain=''
export MAGELENS_THEME=luma MAGELENS_RUNNER=cypress
for argument in "$@"; do
    case "$argument" in
        --container-only) container_only=1 ;;
        --hyva) MAGELENS_THEME=hyva ;;
        --playwright) MAGELENS_RUNNER=playwright ;;
        --help|-h)
            printf 'Usage: ./install.sh [--hyva] [--playwright] [--container-only] [domain]\nDefault: Luma and Cypress. --hyva selects Hyva; --playwright selects Playwright.\n'
            exit 0 ;;
        -*) fail 'Usage: ./install.sh [--hyva] [--playwright] [--container-only] [domain]' ;;
        *)
            [[ -z "$requested_domain" ]] || fail 'Usage: ./install.sh [--hyva] [--playwright] [--container-only] [domain]'
            requested_domain=$argument ;;
    esac
done
if [[ "$MAGELENS_THEME" == hyva || "$MAGELENS_RUNNER" == playwright ]]; then
    [[ "$TEMPLATE_COVERAGE_VERSION" != 1.1.* && "$TEMPLATE_COVERAGE_VERSION" != 1.0.* || -n "${MAGELENS_TEMPLATE_COVERAGE_PACKAGE:-}" ]] \
        || fail 'Hyva and Playwright require template coverage 1.2 or newer. Update TEMPLATE_COVERAGE_VERSION in dependencies.yaml.'
fi
lock_workflow
rm -f .runtime/installed
printf '%s %s\n' "$MAGELENS_THEME" "$MAGELENS_RUNNER" > .runtime/install-profile
if [[ "$MAGELENS_RUNNER" == playwright ]]; then
    cat > .runtime/compose.runner.yaml <<'YAML'
services:
  app:
    ports: !override
      - "127.0.0.1:${APPLICATION_PORT:-80}:${APPLICATION_PORT:-80}"
      - "127.0.0.1:${APPLICATION_HTTPS_PORT:-443}:${APPLICATION_HTTPS_PORT:-443}"
YAML
else
    rm -f .runtime/compose.runner.yaml
fi
mkdir -p .runtime/template-package
# Always include this directory in the Docker context; tarballs are optional.
touch .runtime/template-package/.keep
export TEMPLATE_COVERAGE_PACKAGE=''
if [[ -n "${MAGELENS_TEMPLATE_COVERAGE_PACKAGE:-}" ]]; then
    cp "$MAGELENS_TEMPLATE_COVERAGE_PACKAGE" .runtime/template-coverage.tgz
    TEMPLATE_COVERAGE_PACKAGE=.runtime/template-coverage.tgz
    cp .runtime/template-coverage.tgz .runtime/template-package/template-coverage.tgz
else
    rm -f .runtime/template-coverage.tgz .runtime/template-package/template-coverage.tgz
fi
if [[ ! -f .env ]]; then
    printf 'COMPOSE_PROJECT_NAME=magelens\nAPPLICATION_PORT=80\nAPPLICATION_HTTPS_PORT=443\nCYPRESS_VIEW_PORT=6080\n' > .env
fi
source "$ROOT/bin/application-domain"
configure_application_domain .env "$requested_domain"
UPSTREAM="refs/tags/$MARKSHUST_DOCKER_MAGENTO_VERSION"
say "Acquiring Mark Shust Docker Magento $MARKSHUST_DOCKER_MAGENTO_VERSION from dependencies.yaml"
if [[ ! -d .runtime/docker-magento/.git ]]; then
    git init -q .runtime/docker-magento
    git -C .runtime/docker-magento remote add origin https://github.com/markshust/docker-magento.git
fi
git -C .runtime/docker-magento fetch --depth 1 origin "$UPSTREAM"
git -C .runtime/docker-magento checkout --detach FETCH_HEAD
mkdir -p .runtime/pcov .runtime/magento coverage node_modules src
say 'Exposing pinned Docker Magento bin tools and supporting files'
"$ROOT/bin/expose-tools"
say 'Synchronizing browser coverage versions and dependency locks'
bootstrap_image=$RUNNER_IMAGE
[[ "$MAGELENS_RUNNER" != playwright ]] || bootstrap_image=$PLAYWRIGHT_RUNNER_IMAGE
docker run --rm --pull always --user "$LOCAL_UID:$LOCAL_GID" \
    --mount "type=bind,source=$ROOT,target=/workspace" --workdir /workspace \
    --env CYPRESS_VERSION --env PLAYWRIGHT_VERSION --env TEMPLATE_COVERAGE_VERSION --env CYPRESS_CODE_COVERAGE_VERSION \
    --env MAGELENS_RUNNER --env TEMPLATE_COVERAGE_PACKAGE \
    --env ISTANBUL_LIB_COVERAGE_VERSION --env ISTANBUL_LIB_INSTRUMENT_VERSION --env NYC_VERSION \
    --env npm_config_cache=/tmp/npm-cache \
    --entrypoint node "$bootstrap_image" bin/sync-dependencies.cjs
say "Building PHP/PCOV and $MAGELENS_RUNNER tooling"
dc pull app db redis opensearch
dc build --pull phpfpm runner
# Docker initializes this dependencies volume from the image; refresh it on reruns too.
dc run --rm --no-deps --user root runner chown -R "$LOCAL_UID:$LOCAL_GID" /workspace/node_modules
dc run --rm --no-deps runner npm ci --ignore-scripts --no-audit --no-fund
say 'Configuring Composer with the upstream Docker Magento tools'
start_php_for_setup
"$ROOT/bin/setup-composer-auth"
if [[ ! -f src/.magelens-imported && ( ! -f src/composer.json || -f src/.application-source-ready ) ]]; then
    say 'Installing Magento Composer packages (core code stays in vendor/)'
    "$ROOT/bin/clinotty" bash /application/docker/php/download-magento.sh
fi
dc stop -t 60 app phpfpm
say 'Preparing local Magento source in src/ (preserving an existing installation)'
dc run --rm --no-deps workspace
if [[ "$MAGELENS_THEME" == hyva ]]; then
    say "Installing Hyva $HYVA_VERSION"
    if ! dc run --rm --no-deps phpfpm php /application/docker/php/install-hyva.php --check; then
        dc run --rm --no-deps phpfpm php /application/docker/php/install-hyva.php
        dc run --rm --no-deps phpfpm composer update 'hyva-themes/*' --with-dependencies --prefer-dist --no-interaction --no-progress
    fi
fi
dc run --rm --no-deps runner node bin/prepare.cjs --plain
say 'Starting the dedicated Magento database and search services'
start_dependencies
say 'Installing/configuring Magento and discovered custom modules'
dc run --rm --no-deps --user root phpfpm bash /application/docker/php/install-magento.sh
dc run --rm --no-deps phpfpm php /application/docker/php/theme-scope.php > .runtime/active-themes.json
dc exec -T runner node bin/prepare.cjs --runtime-only --theme-roots .runtime/active-themes.json
if (( container_only )); then
    say 'Creating a container-only HTTPS certificate (host configuration is unchanged)'
    dc run --rm --no-deps --user root --entrypoint sh app -c '
        openssl req -x509 -newkey rsa:2048 -nodes -days 7 \
            -subj "/CN=$1" -addext "subjectAltName=DNS:$1" \
            -keyout /etc/nginx/certs/nginx.key -out /etc/nginx/certs/nginx.crt \
        && chown app:app /etc/nginx/certs/nginx.key /etc/nginx/certs/nginx.crt
    ' sh "$APPLICATION_DOMAIN"
fi
dc up -d --force-recreate phpfpm app
if (( ! container_only )); then
    say "Configuring $APPLICATION_DOMAIN and its local SSL certificate"
    "$ROOT/bin/setup-domain" "$APPLICATION_DOMAIN"
fi
start_dependencies
dc exec -T phpfpm bash /application/docker/php/refresh-assets.sh
if [[ "$MAGELENS_RUNNER" == cypress ]]; then
    dc exec -T runner cypress verify
else
    dc exec -T runner node -e "require('@vitaliiboiko/magento-template-coverage/playwright');require('@playwright/test').chromium.launch().then(browser=>browser.close()).catch(error=>{console.error(error);process.exitCode=1})"
fi
dc exec -T app sh -c 'curl --fail --silent --show-error --insecure --retry 30 --retry-connrefused \
    --retry-delay 2 --max-time 5 --output /dev/null "https://localhost:$APPLICATION_HTTPS_PORT/"'
printf '2\n' > .runtime/installed
say "MageLens is ready. Open $(dc exec -T phpfpm bash /application/docker/php/base-url.sh --print)"
if [[ "$MAGELENS_RUNNER" == cypress ]]; then say "Watch Cypress at $(dc exec -T phpfpm bash /application/docker/php/base-url.sh --print-viewer)"; fi
printf 'Installed %s with %s. Run ./bin/run-coverage (no host Node required).\n' "$MAGELENS_THEME" "$MAGELENS_RUNNER"
